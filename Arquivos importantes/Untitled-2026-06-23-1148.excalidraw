    {
      "id": "L2dx7pm8gzLWzS6HBKx5q",
      "type": "text",
      "x": -2671.3332875569668,
      "y": 796.9642857142859,
      "width": 752.4773976395292,
      "height": 278.85714285714306,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "0K9dlFsWBfDTOaUvsUpwv",
      "index": "a4",
      "roundness": null,
      "seed": 1353192351,
      "version": 1000,
      "versionNonce": 1498979153,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782225420376,
      "link": null,
      "locked": false,
      "text": "Antes de fazer o seu login, lembre-se da nossa missão: \nO nosso prazer é levar o melhor da culinária local e o conforto da\nnossa comida caseira a cada cliente. Cada prato que preparamos\ngarante almoços em família memoráveis e pausas de trabalho\nrevigorantes.\nMais do que isso: o seu esforço diário nos ajuda a apoiar as\ninstituições que combatem a fome de quem mais precisa. \n\nO seu trabalho alimenta e transforma vidas!",
      "fontSize": 24.787301587301606,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Antes de fazer o seu login, lembre-se da nossa missão: \nO nosso prazer é levar o melhor da culinária local e o conforto da nossa comida caseira a cada cliente. Cada prato que preparamos garante almoços em família memoráveis e pausas de trabalho revigorantes.\nMais do que isso: o seu esforço diário nos ajuda a apoiar as instituições que combatem a fome de quem mais precisa. \n\nO seu trabalho alimenta e transforma vidas!",
      "autoResize": false,
      "lineHeight": 1.25
    },
