      "text": "Sobre nosso restaurante:",
      "fontSize": 22.819550858652786,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sobre nosso restaurante:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LxRnKwjXeQODulgMg2-zd",
      "type": "rectangle",
      "x": -1729.4292929292944,
      "y": 1785.42178055322,
      "width": 491.11111111111137,
      "height": 495.8511668868342,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "82XYi18_nTcNKJiEQ_eti",
      "index": "Zzzzzzzzzzzx",
      "roundness": null,
